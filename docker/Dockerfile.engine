# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: Apache-2.0
#
# Builder of liblance_engine.so (docs/design.md §2.2): the Rust crate in
# engine/, which links Lance's crates at the versions of its lockfile.
# Debian trixie, like the dev image's postgres:19rc1-trixie, so the library
# asks for no newer glibc than the server image has.  Lance's build scripts
# compile its protobuf definitions with protoc.
FROM rust:1.99-trixie
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        protobuf-compiler libprotobuf-dev cmake clang libclang-dev pkg-config git file binutils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 builder \
    && git config --system --add safe.directory '*'
ENV CARGO_HOME=/cargo CARGO_TARGET_DIR=/build/target TMPDIR=/tmp
USER builder
WORKDIR /home/builder
