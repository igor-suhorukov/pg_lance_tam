----------------------------------------------------------------------------------
 Aggregate
   ->  Custom Scan (LanceScan) on pairs
         Filter: ((name = 'n7'::text) OR ((origin >= 5) AND (origin <= 6)))
         Lance Columns: origin, name
         Lance Filter: ((`name` = 'n7') OR ((`origin` >= 5) AND (`origin` <= 6)))
         Lance Index: pairs_origin, pairs_name
(6 rows)

SELECT count(*) FROM pairs WHERE name = 'n7' OR origin BETWEEN 5 AND 6;
