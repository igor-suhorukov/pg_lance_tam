(1 row)

SELECT count(*) FROM pairs WHERE origin = 99999;
 count 
-------
     1
(1 row)

VACUUM pairs;
SELECT (i->>'rows')::bigint AS rows FROM jsonb_array_elements(lance.indices('pairs')) i
WHERE i->>'name' = 'pairs_origin';
 rows  
-------
