   ->  Custom Scan (LanceScan) on pairs
         Filter: ((t < 15) AND (origin = ANY ('{1,2,3}'::integer[])))
         Lance Columns: origin, t
         Lance Filter: (`origin` IN (1, 2, 3)) AND (`t` < 15)
         Lance Index: pairs_origin
(6 rows)

SELECT count(*) FROM pairs WHERE origin IN (1, 2, 3) AND t < 15;
