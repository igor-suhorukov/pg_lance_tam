 dblink_send_query 
-------------------
                 1
(1 row)

DO $$
BEGIN
    WHILE NOT EXISTS (SELECT FROM pg_locks WHERE locktype = 'advisory' AND NOT granted) LOOP
        PERFORM pg_sleep(0.01);
    END LOOP;
END $$;
INSERT INTO v_race SELECT g, 'new' FROM generate_series(1, 40) g;
SELECT pg_advisory_unlock(424242);
